  "mode": "dark",
  "primitive": {
    "color": {
      "paper": {
        "$type": "color",
        "$value": "#151714"
      },
      "recess": {
        "$type": "color",
        "$value": "#242722"
      },
      "ink": {
        "$type": "color",
        "$value": "#DCD6C5"
      },
      "secondaryInk": {
        "$type": "color",
