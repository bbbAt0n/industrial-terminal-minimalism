{
  "version": "1.0.0",
  "mode": "light",
  "primitive": {
    "color": {
      "paper": {
        "$type": "color",
        "$value": "#E9E6DF"
      },
      "recess": {
        "$type": "color",
        "$value": "#D4D0C6"
      },
      "ink": {
        "$type": "color",
        "$value": "#2E3432"
      },
      "secondaryInk": {
        "$type": "color",
        "$value": "#535950"
      },
      "amber": {
        "$type": "color",
        "$value": "#99734C"
      },
      "functionalAmber": {
        "$type": "color",
        "$value": "#73502F"
      },
      "edge": {
        "$type": "color",
        "$value": "#706F65"
      },
      "rule": {
        "$type": "color",
        "$value": "#ACA99E"
      },
      "selection": {
        "$type": "color",
        "$value": "#2E3432"
      },
      "selectionInk": {
        "$type": "color",
        "$value": "#E9E6DF"
      },
      "selectionHover": {
        "$type": "color",
        "$value": "#414740"
      },
      "red": {
        "$type": "color",
        "$value": "#8C3D35"
      },
      "blue": {
        "$type": "color",
        "$value": "#365C72"
      }
    }
  },
  "semantic": {
    "color": {
      "canvas": {
        "$type": "color",
        "$value": "{primitive.color.paper}"
      },
      "surface": {
        "$type": "color",
        "$value": "{primitive.color.recess}"
      },
      "text": {
        "$type": "color",
        "$value": "{primitive.color.ink}"
      },
      "muted": {
        "$type": "color",
        "$value": "{primitive.color.secondaryInk}"
      },
      "accentSeed": {
        "$type": "color",
        "$value": "{primitive.color.amber}"
      },
      "accentText": {
        "$type": "color",
        "$value": "{primitive.color.functionalAmber}"
      },
      "border": {
        "$type": "color",
        "$value": "{primitive.color.edge}"
      },
      "divider": {
        "$type": "color",
        "$value": "{primitive.color.rule}"
      },
      "selected": {
        "$type": "color",
        "$value": "{primitive.color.selection}"
      },
      "onSelected": {
        "$type": "color",
        "$value": "{primitive.color.selectionInk}"
      },
      "selectedHover": {
        "$type": "color",
        "$value": "{primitive.color.selectionHover}"
      },
      "error": {
        "$type": "color",
        "$value": "{primitive.color.red}"
      },
      "info": {
        "$type": "color",
        "$value": "{primitive.color.blue}"
      },
      "focus": {
        "$type": "color",
        "$value": "{primitive.color.functionalAmber}"
      }
    }
  },
  "component": {
    "button": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.selected}"
      },
      "fg": {
        "$type": "color",
        "$value": "{semantic.color.onSelected}"
      },
      "hover": {
        "$type": "color",
        "$value": "{semantic.color.selectedHover}"
      }
    },
    "secondaryButton": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.canvas}"
      },
      "fg": {
        "$type": "color",
        "$value": "{semantic.color.text}"
      },
      "hover": {
        "$type": "color",
        "$value": "{semantic.color.surface}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border}"
      }
    },
    "field": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.canvas}"
      },
      "fg": {
        "$type": "color",
        "$value": "{semantic.color.text}"
      },
      "border": {
        "$type": "color",
        "$value": "{semantic.color.border}"
      },
      "invalid": {
        "$type": "color",
        "$value": "{semantic.color.error}"
      }
    },
    "row": {
      "bg": {
        "$type": "color",
        "$value": "{semantic.color.canvas}"
      },
      "hover": {
        "$type": "color",
        "$value": "{semantic.color.surface}"
      },
      "selected": {
        "$type": "color",
        "$value": "{semantic.color.selected}"
      },
      "selectedText": {
        "$type": "color",
        "$value": "{semantic.color.onSelected}"
      }
    }
  }
